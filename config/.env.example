# ============================================================
# TradeAgent - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your keys.
# All keys are OPTIONAL — the bot runs in demo/paper mode without them.
# ============================================================

# ── General ──────────────────────────────────────────────────
TRADE_MODE=paper                  # paper | live
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
DEFAULT_MARKET=forex              # forex | crypto | equity

# ── OANDA (Forex) ───────────────────────────────────────────
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice        # practice | live

# ── MetaTrader 5 (Forex - Windows Only) ─────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                         # Path to terminal64.exe

# ── CCXT / Crypto Exchanges ─────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=

# ── Fundamental Data ────────────────────────────────────────
FRED_API_KEY=                     # Free at https://fred.stlouisfed.org/docs/api/api_key.html
FINNHUB_API_KEY=                  # Free at https://finnhub.io/register

# ── News & Sentiment ────────────────────────────────────────
NEWS_API_KEY=                     # Free at https://newsapi.org/register
OPENAI_API_KEY=                   # For LLM-based deep analysis (optional)

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # Get from @BotFather on Telegram
TELEGRAM_CHAT_ID=                 # Your personal chat ID

# ── Redis (Optional - for hot data caching) ──────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ──────────────────────────────────────────────────
DUCKDB_PATH=data/tradeagent.duckdb
